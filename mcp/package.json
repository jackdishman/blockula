{
  "name": "@blockula/mcp",
  "version": "0.5.0",
  "description": "🧛 MCP server for Blockula — lets any coding agent run a node, hold a post-quantum wallet, send FANG and claim .boo names",
  "type": "module",
  "bin": {
    "blockula-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node ../scripts/mcp-shrinkwrap.mjs --dry-run && tsx test/network.ts && tsx test/spend.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@blockula/sdk": "0.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "^7.0.2"
  },
  "author": "Jack Dishman",
  "keywords": [
    "blockula",
    "mcp",
    "model-context-protocol",
    "post-quantum",
    "blockchain",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackdishman/blockula.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/jackdishman/blockula#readme",
  "bugs": {
    "url": "https://github.com/jackdishman/blockula/issues"
  }
}
