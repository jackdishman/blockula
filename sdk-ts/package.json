{
  "name": "@blockula/sdk",
  "version": "0.5.1",
  "description": "\ud83e\udddb TypeScript SDK for Blockula \u2014 post-quantum wallets (ML-DSA-65), .boo names, transfers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./passkey": "./dist/passkey.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx test/e2e.ts",
    "test:kat": "tsx test/kat.ts",
    "test:vectors": "tsx test/passkey-vectors.ts && tsx test/proof-vectors.ts && tsx test/tx-vectors.ts && tsx test/unit.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@scure/base": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsx": "*",
    "typescript": "*"
  },
  "author": "Jack Dishman",
  "keywords": [
    "blockula",
    "post-quantum",
    "ml-dsa",
    "passkey",
    "webauthn",
    "blockchain",
    "wallet"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackdishman/blockula.git",
    "directory": "sdk-ts"
  },
  "homepage": "https://github.com/jackdishman/blockula#readme",
  "bugs": {
    "url": "https://github.com/jackdishman/blockula/issues"
  }
}
