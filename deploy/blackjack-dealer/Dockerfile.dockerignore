# The dealer image's build context (deploy/blackjack-dealer/Dockerfile), from the repository's root.
# Deny by default: only the three packages it builds and the manifests npm ci resolves are sent.
**
!package.json
!package-lock.json
!sdk-ts/
!sdk-ts/**
!web/
web/**
!web/package.json
!mcp/
mcp/**
!mcp/package.json
!services/
!services/blackjack/
!services/blackjack/core/
!services/blackjack/core/**
!services/blackjack/dealer/
!services/blackjack/dealer/**
!services/blackjack/render/
services/blackjack/render/**
!services/blackjack/render/package.json
!services/blackjack/xbot/
services/blackjack/xbot/**
!services/blackjack/xbot/package.json
!deploy/
deploy/**
!deploy/blackjack-dealer/
deploy/blackjack-dealer/**
!deploy/blackjack-dealer/entrypoint.sh

# Never copy host build products, local configuration, keys or seed stores.
**/node_modules
**/dist
**/*.tsbuildinfo
**/.env*
**/.git
**/.context
**/.claude
**/secrets
**/*.key
**/wallet.json
**/*-wallet.json
**/*-key.json
**/*-secret.json
**/*.enc.json
**/*.enc.json.backup
**/private
