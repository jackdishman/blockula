{
  "name": "main: reviewed PRs with green CI",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": ["~DEFAULT_BRANCH"]
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Node (Rust tests + local multi-validator testnet)", "integration_id": 15368 },
          { "context": "Packages + wallet build", "integration_id": 15368 },
          { "context": "Wallet e2e (Playwright, Chromium)", "integration_id": 15368 },
          { "context": "Clippy", "integration_id": 15368 },
          { "context": "Dependencies (cargo-deny, npm audit)", "integration_id": 15368 },
          { "context": "Supply-chain pins, workflows, monitoring config", "integration_id": 15368 },
          { "context": "ml-dsa (node)", "integration_id": 15368 },
          { "context": "@noble/post-quantum (SDK)", "integration_id": 15368 },
          { "context": "Fuzz harness", "integration_id": 15368 }
        ]
      }
    },
    {
      "type": "required_linear_history"
    }
  ]
}
